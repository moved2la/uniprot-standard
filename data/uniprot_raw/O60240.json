      },
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "27832861"
      }
     ],
     "value": "Interacts with ABHD5 (By similarity). Interacts with CIDEC (PubMed:23399566). Interacts with AQP7 (PubMed:27832861)"
    }
   ],
