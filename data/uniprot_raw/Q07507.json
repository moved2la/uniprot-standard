 "comments": [
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000250"
      }
     ],
     "value": "Seems to mediate adhesion by cell surface integrin binding. May serve as a communication link between the dermal fibroblast cell surface and its extracellular matrix environment. Enhances TGFB1 activity. Inhibits cell proliferation. Accelerates collagen fibril formation, and stabilizes collagen fibrils against low-temperature dissociation (By similarity)"
    }
   ],
   "commentType": "FUNCTION"
  },
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000250"
      }
     ],
     "value": "Interacts with TGFB1, DCN and collagen"
    }
   ],
   "commentType": "SUBUNIT"
  },
  {
   "commentType": "INTERACTION",
