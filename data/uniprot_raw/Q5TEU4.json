      },
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "35614220"
      }
     ],
     "value": "Interacts with NDUFAF8, leading to stabilize NDUFAF5 (PubMed:27499296). Interacts with NDUFS7 (PubMed:27226634). Interacts with PYURF (via TRM112 domain); the interaction is direct and stabilizes NDUFAF5 protein (PubMed:35614220)"
    }
