     "evidences": [
      {
       "evidenceCode": "ECO:0000250",
       "source": "UniProtKB",
       "id": "O88932"
      }
     ],
     "value": "Channel activity is regulated by variations of cytosolic pH; reversibly inhibited by acidic pH values. Inhibited by Ba(2+) and Cs(+) in a voltage-dependent manner"
    }
   ],
   "commentType": "ACTIVITY REGULATION"
  },
  {
