 "comments": [
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "16778136"
      }
     ],
     "value": "Primate-specific plasma protein associated with apolipoprotein L-I (apoL-I)-containing high-density lipoprotein (HDL). This HDL particle, termed trypanosome lytic factor-1 (TLF-1), mediates human innate immune protection against many species of African trypanosomes. Binds hemoglobin with high affinity and may contribute to the clearance of cell-free hemoglobin to allow hepatic recycling of heme iron"
    }
   ],
