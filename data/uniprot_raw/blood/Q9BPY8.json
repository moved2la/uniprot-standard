 "comments": [
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000250",
       "source": "UniProtKB",
       "id": "Q8R1H0"
      },
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "27708256"
      }
     ],
     "value": "Atypical homeodomain protein which does not bind DNA and is required to modulate cardiac growth and development. Acts via its interaction with SRF, thereby modulating the expression of SRF-dependent cardiac-specific genes and cardiac development. Prevents SRF-dependent transcription either by inhibiting SRF binding to DNA or by recruiting histone deacetylase (HDAC) proteins that prevent transcription by SRF. Overexpression causes cardiac hypertrophy (By similarity). May act as a tumor suppressor. Acts as a co-chaperone for HSPA1A and HSPA1B chaperone proteins and assists in chaperone-mediated protein refolding (PubMed:27708256)"
    }
   ],
   "commentType": "FUNCTION"
  },
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000250",
       "source": "UniProtKB",
       "id": "Q8R1H0"
      },
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "27708256"
      }
     ],
     "value": "Interacts with serum response factor (SRF). Component of a large complex containing histone deacetylases such as HDAC2 (By similarity). Interacts with the acetylated forms of HSPA1A and HSPA1B. Interacts with HSPA8 (PubMed:27708256)"
    }
   ],
