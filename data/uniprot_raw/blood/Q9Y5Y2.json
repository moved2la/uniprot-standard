   ],
   "note": {
    "texts": [
     {
      "evidences": [
       {
        "evidenceCode": "ECO:0000255",
        "source": "HAMAP-Rule",
        "id": "MF_03039"
       }
      ],
      "value": "Binds 4 [4Fe-4S] clusters per heterotetramer. Contains two stable clusters in the N-termini of NUBP1 and two labile, bridging clusters between subunits of the NUBP1-NUBP2 heterotetramer."
     }
    ]
   }
  },
