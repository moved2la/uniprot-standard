 "comments": [
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "10816584"
      },
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "15840583"
      }
     ],
     "value": "Probably involved in the organization of the actin cytoskeleton by acting downstream of CDC42, inducing actin filament assembly. Alters CDC42-induced cell shape changes. In activated T-cells, may play a role in CDC42-mediated F-actin accumulation at the immunological synapse. May play a role in early contractile events in phagocytosis in macrophages"
    }
   ],
   "commentType": "FUNCTION"
  },
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "10816584"
      }
     ],
     "value": "Interacts with CDC42 (in GTP-bound form). Interacts weakly with RAC1 and not at all with RHOA"
    }
   ],
   "commentType": "SUBUNIT"
  },
  {
   "commentType": "SUBCELLULAR LOCATION",
   "note": {
    "texts": [
     {
      "value": "Recruited to the activated TCR prior actin polymerization. Localizes at the phagocytic cup of macrophages"
     }
    ]
   },
   "subcellularLocations": [
    {
     "location": {
      "value": "Cytoplasm, cytoskeleton",
      "id": "SL-0090"
     }
    },
    {
     "location": {
      "value": "Cell membrane",
      "id": "SL-0039"
     },
     "topology": {
      "value": "Lipid-anchor",
      "id": "SL-9901"
     }
    },
    {
     "location": {
      "value": "Cell projection, phagocytic cup",
      "id": "SL-0473"
     }
    }
   ]
  },
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "15840583"
      }
     ],
     "value": "Widely expressed. Expressed at higher level in T-lymphocytes. Highly expressed in CCRF-CEM T-lymphocytes, Jurkat T-lymphocytes, and Raji B-lymphocytes compared (at protein level)"
    }
   ],
   "commentType": "TISSUE SPECIFICITY"
  },
  {
   "texts": [
    {
     "value": "The CRIB domain mediates interaction with CDC42"
    }
   ],
   "commentType": "DOMAIN"
  },
  {
   "texts": [
    {
     "value": "CDC42SE2 is mapped in the genomic region associated with schizophrenia"
    }
   ],
   "commentType": "MISCELLANEOUS"
  },
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000305"
      }
     ],
     "value": "Belongs to the CDC42SE/SPEC family"
    }
   ],
   "commentType": "SIMILARITY"
  }
