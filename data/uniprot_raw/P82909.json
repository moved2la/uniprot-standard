        "id": "P82908"
       }
      ],
      "value": "Mitochondrion",
      "id": "SL-0173"
     }
    }
   ]
  },
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000305"
      }
     ],
     "value": "Belongs to the alpha-ketoglutarate dehydrogenase component 4 family"
    }
   ],
   "commentType": "SIMILARITY"
  },
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000250",
       "source": "UniProtKB",
       "id": "P82908"
      },
      {
       "evidenceCode": "ECO:0000250",
       "source": "UniProtKB",
       "id": "Q9CQX8"
      },
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "25838379"
      }
     ],
     "value": "Was originally identified in the small subunit (28S) of mitochondrial ribosomes that were purified on sucrose gradients (By similarity). This observation has been challenged by experiments showing KGD4 copurification with the oxoglutarate dehydrogenase complex (OGDHC), also called alpha-ketoglutarate dehydrogenase complex (KGDH). Both mitochondrial ribosome 28S subunit and OGDC have a similar size and OGDC is highly abundant, therefore OGDC has been found to contaminate ribosomal preparations performed by sequential centrifugation steps (By similarity). In addition, KGD4 could not be located in the structure of the human mitochondrial ribosome, supporting the hypothesis that it is not a mitoribosomal protein (PubMed:25838379)"
    }
   ],
   "commentType": "CAUTION"
  }
 ],
