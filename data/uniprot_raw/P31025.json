      },
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "17869594"
      }
     ],
     "value": "Predominantly monomer (PubMed:17869594). May form homodimer (PubMed:17869594). Interacts with LMBR1L; this interaction mediates the endocytosis of LCN1 (PubMed:11287427, PubMed:12591932)"
    }
   ],
