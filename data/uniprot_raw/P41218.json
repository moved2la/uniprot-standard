  {
   "commentType": "SUBCELLULAR LOCATION",
   "note": {
    "texts": [
     {
      "value": "Uniformly distributed throughout the interphase cell nucleus. Associates with chromatin"
     }
    ]
   },
   "subcellularLocations": [
    {
     "location": {
      "value": "Nucleus",
      "id": "SL-0191"
     }
    },
