  {
   "commentType": "SUBCELLULAR LOCATION",
   "note": {
    "texts": [
     {
      "evidences": [
       {
        "evidenceCode": "ECO:0000250",
        "source": "UniProtKB",
        "id": "Q9R060"
       }
      ],
      "value": "Enriched in centrioles of microtubule asters during prophase, prometaphase and telophase stages of mitosis. Localized at centrioles and in the nucleus at interphase. Colocalizes with nubp-2 at prometaphase. Specifically localizes to the axenome of motile cilia as opposed to primary non-motile cilia. Localization is independent of NUBP2 and KIFC1"
     }
    ]
   },
