 "comments": [
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000250",
       "source": "UniProtKB",
       "id": "Q9R060"
      },
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "18573874"
      }
     ],
     "value": "Component of the cytosolic iron-sulfur (Fe/S) protein assembly (CIA) machinery (PubMed:18573874). Required for maturation of extramitochondrial Fe-S proteins (PubMed:18573874). The NUBP1-NUBP2 heterotetramer forms a Fe-S scaffold complex, mediating the de novo assembly of an Fe-S cluster and its transfer to target apoproteins (PubMed:18573874). Implicated in the regulation of centrosome duplication (By similarity). Negatively regulates cilium formation and structure (By similarity)"
    }
   ],
   "commentType": "FUNCTION"
  },
  {
   "commentType": "COFACTOR",
   "cofactors": [
    {
     "name": "[4Fe-4S] cluster",
     "evidences": [
      {
       "evidenceCode": "ECO:0000255",
       "source": "HAMAP-Rule",
       "id": "MF_03038"
      }
     ],
     "cofactorCrossReference": {
      "database": "ChEBI",
      "id": "CHEBI:49883"
     }
    }
   ],
   "note": {
    "texts": [
     {
      "evidences": [
       {
        "evidenceCode": "ECO:0000255",
        "source": "HAMAP-Rule",
        "id": "MF_03038"
       }
      ],
      "value": "Binds 4 [4Fe-4S] clusters per heterotetramer. Contains two stable clusters in the N-termini of NUBP1 and two labile, bridging clusters between subunits of the NUBP1-NUBP2 heterotetramer."
     }
    ]
   }
  },
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000250",
       "source": "UniProtKB",
       "id": "Q9R060"
      },
      {
       "evidenceCode": "ECO:0000255",
       "source": "HAMAP-Rule",
       "id": "MF_03038"
      },
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "18573874"
      }
     ],
     "value": "Heterotetramer of 2 NUBP1 and 2 NUBP2 chains (By similarity). Interacts with KIFC1 (By similarity). Interacts with NUBP2 (PubMed:18573874). Interacts with the BBS/CCT complex subunit CCT1 (By similarity)"
    }
   ],
   "commentType": "SUBUNIT"
  },
  {
   "commentType": "INTERACTION",
