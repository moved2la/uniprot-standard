       "id": "16895918"
      },
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "20625546"
      }
     ],
     "value": "Interacts with RELA (By similarity). Interacts with the heterodimer formed by CAPZA1 and CAPZB"
    }
   ],
