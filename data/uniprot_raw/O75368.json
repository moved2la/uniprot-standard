      },
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "34870550"
      }
     ],
     "value": "Monomer (PubMed:16511048). Interacts with PFN1/Profilin-1 (PubMed:34331014). Interacts with ERBB2 (PubMed:32381043). Interacts with ATG12 (PubMed:34870550). Interacts with BECN1 (PubMed:34870550). Interacts with translating ribosomes (PubMed:34331014, PubMed:34870550)"
    }
   ],
