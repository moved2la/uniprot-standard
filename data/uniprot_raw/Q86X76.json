 "comments": [
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "38430071"
      }
     ],
     "value": "Catalyzes the hydrolysis of the amide bond in N-(4-oxoglutarate)-L-cysteinylglycine (deaminated glutathione), a metabolite repair reaction to dispose of the harmful deaminated glutathione (PubMed:38430071). Plays a role in cell growth and apoptosis: loss of expression promotes cell growth, resistance to DNA damage stress and increased incidence to NMBA-induced tumors. Has tumor suppressor properties that enhances the apoptotic responsiveness in cancer cells; this effect is additive to the tumor suppressor activity of FHIT. It is also a negative regulator of primary T-cells"
    }
   ],
   "commentType": "FUNCTION"
  },
  {
   "commentType": "CATALYTIC ACTIVITY",
