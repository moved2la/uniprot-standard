 "comments": [
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000250"
      }
     ],
     "value": "Cold-inducible mRNA binding protein that enhances global protein synthesis at both physiological and mild hypothermic temperatures. Reduces the relative abundance of microRNAs, when overexpressed. Enhances phosphorylation of translation initiation factors and active polysome formation (By similarity)"
    }
   ],
   "commentType": "FUNCTION"
  },
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000250"
      }
     ],
     "value": "Interacts with RPL4. Associates with the 60S ribosomal subunits in an RNA-independent manner. Associates with ribosomes (By similarity)"
    }
   ],
   "commentType": "SUBUNIT"
  },
