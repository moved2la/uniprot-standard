   "commentType": "POLYMORPHISM"
  },
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000303",
       "source": "Reference",
       "id": "Ref.10"
      }
     ],
     "value": "Alleles IGLC3*01, IGLC3*02, and IGLC3*03 display the following serological isotype: Mcg-, Kern- and Oz+. The Mcg-isotype marker is characterized by Ala-6, Ser-8 and Thr-57; the Ke- marker by Ser-46 and the Oz+ marker by Lys-83. Allele IGLC3*04 displays the following serological isotype: Mcg-, Kern- and Oz-. The Mcg- isotype marker is characterized by Ala-6, Ser-8 and Thr-57; the Ke- marker by Ser-46 and the Oz- marker by Arg-83"
    }
   ],
