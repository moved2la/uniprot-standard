 "comments": [
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "23908353"
      }
     ],
     "value": "Fast twitching myosin mediating the high-velocity and low-tension contractions of specific striated muscles"
    }
   ],
   "commentType": "FUNCTION"
  },
  {
   "texts": [
    {
     "value": "Muscle myosin is a hexameric protein that consists of 2 heavy chain subunits (MHC), 2 alkali light chain subunits (MLC) and 2 regulatory light chain subunits (MLC-2)"
    }
   ],
   "commentType": "SUBUNIT"
  },
  {
   "commentType": "SUBCELLULAR LOCATION",
   "note": {
    "texts": [
     {
      "value": "Thick filaments of the myofibrils"
     }
    ]
   },
   "subcellularLocations": [
    {
     "location": {
      "value": "Cytoplasm, myofibril",
      "id": "SL-0312"
     }
    }
   ]
  },
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "12110653"
      }
     ],
     "value": "Specifically expressed in extraocular and laryngeal muscles"
    }
   ],
   "commentType": "TISSUE SPECIFICITY"
  },
  {
   "texts": [
    {
     "value": "The rodlike tail sequence is highly repetitive, showing cycles of a 28-residue repeat pattern composed of 4 heptapeptides, characteristic for alpha-helical coiled coils"
    }
   ],
   "commentType": "DOMAIN"
  },
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000305"
      }
     ],
     "value": "Limited proteolysis of myosin heavy chain produces 1 light meromyosin (LMM) and 1 heavy meromyosin (HMM). HMM can be further cleaved into 2 globular subfragments (S1) and 1 rod-shaped subfragment (S2)"
    }
   ],
   "commentType": "DOMAIN"
  },
  {
   "texts": [
    {
     "value": "The head-like domain S1 exhibits a much faster ATP-induced detachment from actin, and ADP affinity is more than 3-fold weaker than other myosins"
    }
   ],
   "commentType": "DOMAIN"
  },
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000305"
      }
     ],
     "value": "Belongs to the TRAFAC class myosin-kinesin ATPase superfamily. Myosin family"
    }
   ],
   "commentType": "SIMILARITY"
  }
 ],
