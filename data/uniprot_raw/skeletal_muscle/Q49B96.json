 "comments": [
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "23345593"
      },
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "35750769"
      }
     ],
     "value": "Assembly factor for cytochrome c oxidase (respiratory chain complex IV, CIV) (PubMed:35750769). Acts as a COX11 chaperone that supports COX11 copper coordination (PubMed:35750769). Also stimulates SCO2-mediated metalation of COX2 (PubMed:35750769). Required for the transduction of an SCO1-dependent redox signal from the mitochondrion to ATP7A to regulate cellular copper homeostasis (PubMed:23345593). In the absence of COX11, capable of stimulating copper delivery to the copper B site of COX1 (PubMed:35750769)"
    }
   ],
   "commentType": "FUNCTION"
  },
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "23676665"
      },
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "35750769"
      }
     ],
     "value": "Interacts with CHCHD4/MIA40 forming transient intermolecular disulfide bridges (PubMed:23676665). Interacts with COX11; to support COX11 dimerization and copper coordination (PubMed:35750769)"
    }
   ],
   "commentType": "SUBUNIT"
  },
  {
   "commentType": "SUBCELLULAR LOCATION",
   "note": {
