 "comments": [
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000250"
      }
     ],
     "value": "One HIP oligomer binds the ATPase domains of at least two HSC70 molecules dependent on activation of the HSC70 ATPase by HSP40. Stabilizes the ADP state of HSC70 that has a high affinity for substrate protein. Through its own chaperone activity, it may contribute to the interaction of HSC70 with various target proteins (By similarity)"
    }
   ],
   "commentType": "FUNCTION"
  },
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000250"
      },
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "21728385"
      }
     ],
     "value": "Homotetramer. Interacts with HSC70 as well as DNAJ homologs and HSP90 (By similarity). Interacts (via the C-terminus 303- 319 AA) with GRK5"
    }
   ],
