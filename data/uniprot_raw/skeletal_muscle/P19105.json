   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000250"
      }
     ],
     "value": "Phosphorylation increases the actin-activated myosin ATPase activity and thereby regulates the contractile activity. It is required to generate the driving force in the migration of the cells but not necessary for localization of myosin-2 at the leading edge (By similarity)"
    }
   ],
